# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed or shared.

# --- Angel One SmartAPI (market data only; no orders are ever placed) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
