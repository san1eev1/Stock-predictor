# --- Telegram (final phase) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paper trading capital (INR) ---
PAPER_CAPITAL_INTRADAY=100000
PAPER_CAPITAL_LONGTERM=100000

